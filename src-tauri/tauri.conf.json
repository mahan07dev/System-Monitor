{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "System Monitor",
  "version": "1.0.0",
  "identifier": "com.mahan07dev.systemmonitor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
{
    "title": "System Monitor",
    "width": 1400,
    "height": 700,
    "minWidth": 1200,
    "minHeight": 600,
    "resizable": true,
    "center": true
}
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
      "category": "Utility",

  "shortDescription": "Monitor your computer in real time.",

  "longDescription": "A modern, lightweight system monitor with detailed hardware and performance statistics.",

  "publisher": "Mahan07dev",

  "copyright": "© 2026 Mahan07dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
